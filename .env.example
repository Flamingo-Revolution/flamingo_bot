# Azure model access. Real values belong in .env locally and Secret Manager in production.
AZURE_OPENAI_API_BASE=
AZURE_OPENAI_API_LLM_KEY=

# Google Cloud data plane shared by localhost and production.
GCP_PROJECT_ID=
GCP_BILLING_ACCOUNT=
FIRESTORE_DATABASE_ID=flamingo-rag
# Quota counters, deliberately a separate database. Firestore grants write access
# per database and not per collection, so this is what lets the serving identity
# write its counters while the corpus above stays read-only to it.
FLAMINGO_QUOTA_DATABASE_ID=flamingo-quotas
# Optional locally. Use the dedicated runtime or ingestion identity as appropriate.
GCP_IMPERSONATE_SERVICE_ACCOUNT=

# Absolute paths to local source checkouts used only by the ingestion command.
FLAMINGO_DOSSIER_REPO=
FLAMINGO_REVOLUTION_REPO=
DIASPORA_ZBARKON_REPO=

# Runtime controls.
FLAMINGO_ENVIRONMENT=development
FLAMINGO_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4321,https://flamingorevolution.eu,https://www.flamingorevolution.eu,https://diaspora-zbarkon.com,https://www.diaspora-zbarkon.com
FLAMINGO_RETRIEVAL_CANDIDATES=7
FLAMINGO_RELEVANCE_DISTANCE_THRESHOLD=0.65
# Conversation memory. The client replays these turns; the service stores none.
# Set FLAMINGO_HISTORY_TURNS=0 to disable follow-up handling entirely.
FLAMINGO_HISTORY_TURNS=6
FLAMINGO_HISTORY_CHARS=4000
FLAMINGO_CHAT_CONCURRENCY=8
# In-process burst shield. Sheds a flood before it reaches the durable quotas.
FLAMINGO_RATE_LIMIT_REQUESTS=20
FLAMINGO_RATE_LIMIT_WINDOW_SECONDS=60
# Durable quotas held in Firestore and shared by every serving instance. These are
# the ceilings on what a visitor, and then a whole day, can cost.
FLAMINGO_CLIENT_QUOTA_REQUESTS=10
FLAMINGO_CLIENT_QUOTA_WINDOW_SECONDS=3600
FLAMINGO_DAILY_QUOTA_REQUESTS=100
FLAMINGO_DAILY_QUOTA_WINDOW_SECONDS=86400
# Trailing X-Forwarded-For entries appended by trusted infrastructure that are not
# the caller. Zero for Cloud Run reached directly; 1 behind an HTTPS load balancer.
FLAMINGO_TRUSTED_PROXY_HOPS=0
FLAMINGO_SAFETY_SALT=

# The production container sets this to /app/widget. The local default is frontend/dist.
FLAMINGO_WIDGET_DIR=frontend/dist
